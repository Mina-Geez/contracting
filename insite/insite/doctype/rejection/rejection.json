{
  "doctype": "DocType",
  "name": "Rejection",
  "module": "Insite",
  "engine": "InnoDB",
  "editable_grid": 1,
  "autoname": "naming_series:",
  "naming_rule": "By \"Naming Series\" field",
  "title_field": "rejection_summary",
  "show_title_field_in_link": 1,
  "allow_rename": 0,
  "track_changes": 1,
  "creation": "2026-09-04 00:00:00.000000",
  "modified": "2026-09-04 02:00:00.000000",
  "owner": "Administrator",
  "modified_by": "Administrator",
  "sort_field": "modified",
  "sort_order": "DESC",
  "field_order": [
    "naming_series",
    "rejection_summary",
    "status",
    "column_break_head",
    "project",
    "scope_item",
    "company",
    "currency",
    "what_section",
    "item_code",
    "item_name",
    "rejected_qty",
    "uom",
    "column_break_what",
    "rate",
    "rejected_amount",
    "delivery_note",
    "why_section",
    "reason",
    "column_break_why",
    "rejected_by",
    "reported_on",
    "target_date",
    "closing_section",
    "resolution",
    "column_break_closing",
    "credit_note",
    "rework_delivery_note",
    "closed_on"
  ],
  "fields": [
    {
      "fieldname": "naming_series",
      "fieldtype": "Select",
      "label": "Series",
      "options": "REJ-.YYYY.-",
      "default": "REJ-.YYYY.-",
      "hidden": 1
    },
    {
      "fieldname": "rejection_summary",
      "fieldtype": "Data",
      "label": "Summary",
      "read_only": 1,
      "in_list_view": 1,
      "description": "Written for you from what you enter below."
    },
    {
      "fieldname": "status",
      "fieldtype": "Select",
      "label": "Status",
      "options": "Open\nReworked\nCredited\nAccepted\nCancelled",
      "default": "Open",
      "reqd": 1,
      "in_standard_filter": 1,
      "in_list_view": 1,
      "description": "Open until the work is redone, credited, or accepted after all."
    },
    {
      "fieldname": "column_break_head",
      "fieldtype": "Column Break"
    },
    {
      "fieldname": "project",
      "fieldtype": "Link",
      "options": "Project",
      "label": "Project",
      "reqd": 1,
      "in_standard_filter": 1
    },
    {
      "fieldname": "scope_item",
      "fieldtype": "Link",
      "options": "Scope Item",
      "label": "Scope",
      "reqd": 1,
      "in_standard_filter": 1,
      "description": "Which scope of work this belongs to. Contract Progress reports rejections against it."
    },
    {
      "fieldname": "company",
      "fieldtype": "Link",
      "options": "Company",
      "label": "Company",
      "fetch_from": "project.company",
      "read_only": 1
    },
    {
      "fieldname": "currency",
      "fieldtype": "Link",
      "options": "Currency",
      "label": "Currency",
      "fetch_from": "company.default_currency",
      "read_only": 1,
      "hidden": 1
    },
    {
      "fieldname": "what_section",
      "fieldtype": "Section Break",
      "label": "What Was Rejected"
    },
    {
      "fieldname": "item_code",
      "fieldtype": "Link",
      "options": "Item",
      "label": "Item",
      "reqd": 1,
      "in_list_view": 1
    },
    {
      "fieldname": "item_name",
      "fieldtype": "Data",
      "label": "Item Name",
      "fetch_from": "item_code.item_name",
      "read_only": 1
    },
    {
      "fieldname": "rejected_qty",
      "fieldtype": "Float",
      "label": "Rejected Qty",
      "reqd": 1,
      "in_list_view": 1
    },
    {
      "fieldname": "uom",
      "fieldtype": "Link",
      "options": "UOM",
      "label": "UOM",
      "fetch_from": "item_code.stock_uom",
      "read_only": 1
    },
    {
      "fieldname": "column_break_what",
      "fieldtype": "Column Break"
    },
    {
      "fieldname": "rate",
      "fieldtype": "Currency",
      "label": "Rate",
      "options": "currency",
      "description": "Taken from the delivery line when you report a rejection from a Delivery Note. Change it if the rejected work is worth less."
    },
    {
      "fieldname": "rejected_amount",
      "fieldtype": "Currency",
      "label": "Rejected Amount",
      "options": "currency",
      "description": "Quantity times rate, in company currency. Enter it directly if there is no rate."
    },
    {
      "fieldname": "delivery_note",
      "fieldtype": "Link",
      "options": "Delivery Note",
      "label": "Delivered On",
      "description": "The delivery this work came from, if it was one."
    },
    {
      "fieldname": "why_section",
      "fieldtype": "Section Break",
      "label": "Why"
    },
    {
      "fieldname": "reason",
      "fieldtype": "Small Text",
      "label": "What Was Wrong",
      "reqd": 1
    },
    {
      "fieldname": "column_break_why",
      "fieldtype": "Column Break"
    },
    {
      "fieldname": "rejected_by",
      "fieldtype": "Data",
      "label": "Rejected By",
      "description": "The consultant, engineer or client representative who rejected it."
    },
    {
      "fieldname": "reported_on",
      "fieldtype": "Date",
      "label": "Reported On",
      "default": "Today",
      "reqd": 1
    },
    {
      "fieldname": "target_date",
      "fieldtype": "Date",
      "label": "Fix By"
    },
    {
      "fieldname": "closing_section",
      "fieldtype": "Section Break",
      "label": "Closing",
      "collapsible": 1
    },
    {
      "fieldname": "resolution",
      "fieldtype": "Small Text",
      "label": "What Was Done"
    },
    {
      "fieldname": "column_break_closing",
      "fieldtype": "Column Break"
    },
    {
      "fieldname": "credit_note",
      "fieldtype": "Link",
      "options": "Sales Invoice",
      "label": "Credit Note",
      "depends_on": "eval:doc.status == 'Credited'",
      "mandatory_depends_on": "eval:doc.status == 'Credited'",
      "description": "The credit note you raised. Insite records it; it does not create it."
    },
    {
      "fieldname": "rework_delivery_note",
      "fieldtype": "Link",
      "options": "Delivery Note",
      "label": "Redone On",
      "depends_on": "eval:doc.status == 'Reworked'",
      "description": "The delivery that redid this work, if you want the trail."
    },
    {
      "fieldname": "closed_on",
      "fieldtype": "Date",
      "label": "Closed On",
      "read_only": 1,
      "depends_on": "eval:doc.status && doc.status != 'Open'"
    }
  ],
  "permissions": [
    {
      "role": "System Manager",
      "read": 1,
      "write": 1,
      "create": 1,
      "delete": 1,
      "report": 1,
      "export": 1,
      "share": 1,
      "print": 1,
      "email": 1
    },
    {
      "role": "Contracting Manager",
      "read": 1,
      "write": 1,
      "create": 1,
      "delete": 1,
      "report": 1,
      "export": 1,
      "share": 1,
      "print": 1,
      "email": 1
    },
    {
      "role": "Sales User",
      "read": 1,
      "report": 1
    },
    {
      "role": "Accounts User",
      "read": 1,
      "report": 1
    }
  ]
}
