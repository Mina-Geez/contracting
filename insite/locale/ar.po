msgid "% Invoiced"
msgstr "٪ المفوتر"

msgid "<b>Profitability Analysis</b> and <b>Budget Variance Report</b> are ERPNext's own. They work per scope because Insite registers the Scope as an accounting dimension, so a scope can carry a cost budget like any cost centre."
msgstr "<b>تحليل الربحية</b> و<b>تقرير إنحرافات الموازنة</b> من ERPNext نفسه. يعملان لكل نطاق لأن Insite يسجّل النطاق كبُعد محاسبي، فيمكن للنطاق أن يحمل موازنة تكلفة مثل أي مركز تكلفة."

msgid "<b>Set up once:</b> a <b>Measurement Rule</b> for each kind of work, saying how it is measured. <b>Then per job:</b> a <b>Scope Item</b> on the Project for each scope you report on."
msgstr "<b>إعداد لمرة واحدة:</b> <b>قاعدة القياس</b> لكل نوع من الأعمال، تحدد كيفية قياسه. <b>ثم لكل مشروع:</b> <b>بند نطاق العمل</b> على المشروع لكل نطاق تتابعه في التقارير."

msgid "A field named {0} already exists on the transaction line."
msgstr "يوجد حقل باسم {0} في سطر المستند بالفعل."

msgid "A rule cannot be written from {0}."
msgstr "لا يمكن كتابة قاعدة من {0}."

msgid "Add Scopes"
msgstr "أضف نطاقات"

msgid "Add Scopes to {0}"
msgstr "أضف نطاقات إلى {0}"

msgid "Add a Project in the header before you save this {0}. Insite tracks contracting work by project."
msgstr "أضف المشروع في الترويسة قبل حفظ {0}. Insite يتابع أعمال المقاولات حسب المشروع."

msgid "Add a new field"
msgstr "إضافة حقل جديد"

msgid "Add a new field…"
msgstr "إضافة حقل جديد…"

msgid "Add at least one input. A formula has nothing to read without one."
msgstr "أضف مُدخلًا واحدًا على الأقل. المعادلة بلا مُدخلات لا تقرأ شيئًا."

msgid "Add it"
msgstr "أضفه"

msgid "Add the inputs and a formula first."
msgstr "أضف المُدخلات والمعادلة أولًا."

msgid "Added to every transaction line, for a number measured on site."
msgstr "يُضاف إلى كل سطر في المستندات، لرقم يُقاس في الموقع."

msgid "Added to the Item, for a number that is true of the material."
msgstr "يُضاف إلى الصنف، لرقم ثابت في المادة نفسها."

msgid "Adjust the measurement"
msgstr "تعديل طريقة القياس"

msgid "Already Measured"
msgstr "مقيس بالفعل"

msgid "Already There"
msgstr "موجود بالفعل"

msgid "Amount"
msgstr "المبلغ"

msgid "Applies To"
msgstr "تُطبَّق على"

msgid "Applies To is set to {0}. Fill in the {1} box."
msgstr "تُطبَّق على مضبوطة على {0}. املأ خانة {1}."

msgid "Area"
msgstr "المساحة"

msgid "Attribute"
msgstr "الخاصية"

msgid "Attribute Value"
msgstr "قيمة الخاصية"

msgid "Attribute Value Required"
msgstr "قيمة الخاصية مطلوبة"

msgid "Breaks a tie between two rules that are equally specific. A more specific rule always wins, whatever the priority."
msgstr "يفصل بين قاعدتين متساويتين في التخصيص. القاعدة الأكثر تخصيصًا تفوز دائمًا مهما كانت الأولوية."

msgid "Calculated"
msgstr "المحسوب"

msgid "Calculated Quantity"
msgstr "الكمية المحسوبة"

msgid "Change this under Adjust the measurement, if you need to."
msgstr "غيّرها من تعديل طريقة القياس، إن احتجت."

msgid "Choose a Scope on {0}. Insite tracks contracting work by scope of work."
msgstr "اختر النطاق في {0}. Insite يتابع أعمال المقاولات حسب نطاق العمل."

msgid "Choose how {0} is measured, or untick Measurable."
msgstr "اختر كيف يُقاس {0}، أو ألغِ تحديد \"قابل للقياس\"."

msgid "Combine the names above with + - * / % and abs, round, min, max, pow, sqrt, ceil, floor, pi."
msgstr "اجمع الأسماء أعلاه باستخدام + - * / % والدوال abs و round و min و max و pow و sqrt و ceil و floor و pi."

