msgid "Type at least one scope, one per line."
msgstr "اكتب نطاقًا واحدًا على الأقل، واحدًا في كل سطر."

msgid "Unknown Field"
msgstr "حقل غير معروف"

msgid "Unused Input"
msgstr "مُدخل غير مستخدم"

msgid "Used by rules"
msgstr "القواعد التي تستخدمه"

msgid "Uses the same input names as the rule, for example height * width * count."
msgstr "تستخدم نفس أسماء مُدخلات القاعدة، مثل height * width * count."

msgid "Value"
msgstr "القيمة"

msgid "Variance to Plan"
