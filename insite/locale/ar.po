msgstr "الصنف"

msgid "the transaction line"
msgstr "سطر المستند"

msgid "{0} added. These were already on the project, so they were left alone: {1}"
msgstr "تمت إضافة {0}. وهذه كانت موجودة بالفعل في المشروع فتُركت كما هي: {1}"

